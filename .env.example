# DeepSeek API key，真正调用 AI 时必填；请勿提交真实密钥
DEEPSEEK_API_KEY=your-deepseek-api-key

# 可选：兼容 OpenAI 格式的 DeepSeek 服务地址
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Demo 登录凭据与服务端会话配置；请替换占位符，禁止提交真实值
DEMO_AUTH_EMAIL=owner@example.com
DEMO_AUTH_PASSWORD=your-demo-password
DEMO_AUTH_USER_ID=demo-user
DEMO_AUTH_MERCHANT_ID=demo-merchant-cn
DEMO_SESSION_SECRET=your-demo-session-secret-at-least-32-characters
DEMO_SESSION_TTL_SECONDS=3600

# Next.js 服务端代理到 NestJS API；浏览器只请求同源 /api，不暴露任何密钥
API_BASE_URL=http://localhost:3001
