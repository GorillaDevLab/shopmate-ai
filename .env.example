# =========================================================
# ShopMate AI Demo environment template
# 这里只允许提交示例值或占位符，禁止提交真实 Secret。
# =========================================================

# ---------------------------------------------------------
# Database
# ---------------------------------------------------------

# PostgreSQL connection used by Prisma runtime,
# migrations and Demo Seed.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/shopmate_demo?schema=public

# ---------------------------------------------------------
# API / NestJS
# ---------------------------------------------------------

PORT=3001

# Demo authentication.
# 部署时请替换占位值。
DEMO_AUTH_EMAIL=owner@example.com
DEMO_AUTH_PASSWORD=replace-with-demo-password
DEMO_AUTH_USER_ID=demo-user
DEMO_AUTH_MERCHANT_ID=demo-merchant-cn
DEMO_SESSION_SECRET=replace-with-random-session-secret-at-least-32-characters
# HTTPS production defaults to Secure cookies. Only set false for a temporary HTTP demo.
DEMO_AUTH_SECURE_COOKIE=
DEMO_SESSION_TTL_SECONDS=3600

# ---------------------------------------------------------
# AI Provider
# ---------------------------------------------------------

# 留空时使用 Mock Provider，Demo 仍然可以运行。
# 真实 API Key 只能放在部署平台 Secret / 本地 .env。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=30000

# ---------------------------------------------------------
# Web / Next.js
# ---------------------------------------------------------

# Next.js server-side proxy target.
API_BASE_URL=http://localhost:3001

# ---------------------------------------------------------
# Deployment health check
# ---------------------------------------------------------

DEMO_WEB_URL=http://localhost:3000/
DEMO_API_URL=http://localhost:3001

# Temporary mobile diagnostics (off by default). Public flags require a web rebuild.
NEXT_PUBLIC_ENABLE_DEBUG_REPORT=true
NEXT_PUBLIC_APP_BUILD=unknown
