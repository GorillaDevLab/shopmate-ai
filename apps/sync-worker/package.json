{
  "name": "@shopmate/sync-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src vitest.config.ts --max-warnings=0",
    "test": "vitest run"
  },
  "dependencies": {
    "@shopmate/contracts": "workspace:*",
    "@shopmate/database": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
