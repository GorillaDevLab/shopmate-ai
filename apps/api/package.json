{
  "name": "@shopmate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "pretest": "pnpm --filter @shopmate/database build",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:unit": "vitest run src --passWithNoTests",
    "test:integration": "vitest run test --passWithNoTests",
    "coverage": "vitest run --coverage",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@shopmate/contracts": "workspace:*",
    "@shopmate/database": "workspace:*",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "16.6.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "12.0.1",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "4.1.11",
    "oxlint": "1.80.0",
    "supertest": "7.2.2",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  }
}
