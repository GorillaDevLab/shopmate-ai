{
  "name": "@shopmate/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "scripts": {
    "tenant:bootstrap": "prisma generate && tsx src/tenant-bootstrap-cli.ts",
    "seed:analytics": "tsx src/analytics-demo-seed.ts",
    "build": "prisma generate && tsc --project tsconfig.build.json",
    "generate": "prisma generate",
    "seed": "prisma generate && tsx src/seed.ts",
    "seed:orders": "prisma generate && tsx src/seed.ts && tsx src/order-seed.ts",
    "test": "pnpm run build && prisma validate && node --import tsx --test test/*.test.mjs",
    "typecheck": "prisma generate && tsc --project tsconfig.build.json",
    "lint": "eslint src test prisma.config.ts --max-warnings=0",
    "prisma:format": "prisma format",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.0.0",
    "pg": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.0"
  }
}
