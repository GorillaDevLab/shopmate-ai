generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MerchantStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

model Merchant {
  id     String         @id @default(cuid())
  name   String
  slug   String         @unique
  status MerchantStatus @default(ACTIVE)

  products Product[]
  skus     Sku[]
  orders   Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Product {
  id         String @id @default(cuid())
  merchantId String

  name          String
  description   String?
  features      Json?
  sellingPoints Json?

  price    Decimal @db.Decimal(12, 2)
  currency String  @default("CNY")

  status ProductStatus @default(ACTIVE)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  skus     Sku[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId])
  @@index([merchantId, status])
}

model Sku {
  id         String @id @default(cuid())
  merchantId String
  productId  String

  code           String
  inventory      Int     @default(0)
  cost           Decimal @db.Decimal(12, 2)
  alertThreshold Int     @default(0)

  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantId, code])
  @@index([merchantId])
  @@index([productId])
}

model Order {
  id         String @id @default(cuid())
  merchantId String

  orderNo     String
  orderedAt   DateTime
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(12, 2)

  merchant Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  items    OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantId, orderNo])
  @@index([merchantId, orderedAt])
  @@index([status])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  skuId   String

  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  lineAmount Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku   Sku   @relation(fields: [skuId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([skuId])
}
