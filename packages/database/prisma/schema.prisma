generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

model DemoTenant {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@schema("public")
}

model PlatformConnection {
  id              String                @id
  organizationId  String
  workspaceId     String
  storeId         String
  externalStoreId String
  provider        String                @default("MOCK")
  status          String                @default("ACTIVE")
  generation      Int                   @default(0)
  store           Store                 @relation(fields: [organizationId, workspaceId, storeId], references: [organizationId, workspaceId, id], onDelete: Restrict, onUpdate: NoAction)
  sessions        DemoCommerceSession[]
  syncGrants      SyncWorkerGrant[]
  commerceScopes  CommerceSourceScope[]

  @@unique([storeId, provider])
  @@unique([id, organizationId, workspaceId, storeId, externalStoreId])
  @@schema("public")
}

model DemoCommerceSession {
  id               String              @id
  organizationId   String
  workspaceId      String
  storeId          String              @unique
  connectionId     String              @unique
  externalStoreId  String
  config           Json
  configHash       String
  generatorVersion String
  clockNow         DateTime            @db.Timestamp(3)
  clockRevision    Int                 @default(0)
  revision         Int                 @default(0)
  connection       PlatformConnection  @relation(fields: [connectionId, organizationId, workspaceId, storeId, externalStoreId], references: [id, organizationId, workspaceId, storeId, externalStoreId], onDelete: Restrict, onUpdate: NoAction)
  audits           DemoControlAudit[]
  workerGrants     MockWorkerGrant[]
  runtimes         MockSourceRuntime[]

  @@unique([id, organizationId, workspaceId, storeId, connectionId])
  @@unique([id, organizationId, workspaceId, storeId, connectionId, externalStoreId], map: "DemoCommerceSession_source_binding_key")
  @@schema("demo")
}

model DemoControlAudit {
  id             String              @id
  organizationId String
  workspaceId    String
  storeId        String
  sessionId      String
  connectionId   String
  actorUserId    String
  kind           String
  beforeRevision Int?
  afterRevision  Int
  generation     Int
  configHash     String
  clockNow       DateTime            @db.Timestamp(3)
  createdAt      DateTime            @default(now())
  session        DemoCommerceSession @relation(fields: [sessionId, organizationId, workspaceId, storeId, connectionId], references: [id, organizationId, workspaceId, storeId, connectionId], onDelete: Restrict, onUpdate: NoAction)

  @@index([organizationId, workspaceId, sessionId])
  @@schema("demo")
}

model MockWorkerGrant {
  id              String              @id
  databaseRole    String
  principalUserId String
  organizationId  String
  workspaceId     String
  storeId         String
  sessionId       String
  connectionId    String
  externalStoreId String
  operation       String              @default("SOURCE_BUILD")
  status          String              @default("ACTIVE")
  membership      OrganizationMember  @relation("WorkerMembership", fields: [organizationId, principalUserId], references: [organizationId, userId], onDelete: Restrict, onUpdate: NoAction, map: "MockWorkerGrant_membership_fkey")
  assignment      WorkspaceMember     @relation(fields: [organizationId, workspaceId, principalUserId], references: [organizationId, workspaceId, userId], onDelete: Restrict, onUpdate: NoAction, map: "MockWorkerGrant_workspace_fkey")
  session         DemoCommerceSession @relation(fields: [sessionId, organizationId, workspaceId, storeId, connectionId, externalStoreId], references: [id, organizationId, workspaceId, storeId, connectionId, externalStoreId], onDelete: Restrict, onUpdate: NoAction, map: "MockWorkerGrant_session_fkey")

  @@schema("demo")
}

model MockSourceRuntime {
  sessionId        String
  generation       Int
  organizationId   String
  workspaceId      String
  storeId          String
  connectionId     String
  externalStoreId  String
  sourceConfig     Json
  configHash       String
  generatorVersion String
  runtimeVersion   String
  openingAt        DateTime                  @db.Timestamp(3)
  baselineEnd      DateTime                  @db.Timestamp(3)
  createdAt        DateTime                  @default(dbgenerated("timezone('UTC'::text, CURRENT_TIMESTAMP)")) @db.Timestamp(3)
  session          DemoCommerceSession       @relation(fields: [sessionId, organizationId, workspaceId, storeId, connectionId, externalStoreId], references: [id, organizationId, workspaceId, storeId, connectionId, externalStoreId], onDelete: Restrict, onUpdate: NoAction, map: "Runtime_session_fkey")
  jobs             MockSourceBuildJob[]
  events           MockSourceEvent[]
  versions         MockSourceEntityVersion[]

  @@id([sessionId, generation], map: "Runtime_pkey")
  @@unique([organizationId, workspaceId, storeId, sessionId, connectionId, externalStoreId, generation], map: "Runtime_scope_key")
  @@map("Runtime")
  @@schema("mock_platform")
}

model MockSourceBuildJob {
  organizationId         String
  workspaceId            String
  storeId                String
  sessionId              String
  connectionId           String
  externalStoreId        String
  generation             Int
  revision               BigInt
  targetClockRevision    Int
  targetTime             DateTime            @db.Timestamp(3)
  baseRevision           BigInt
  baseHighEventSeq       BigInt
  baseProcessedThrough   DateTime            @db.Timestamp(3)
  createdAt              DateTime            @db.Timestamptz(3)
  state                  String
  leaseGrantId           String
  leaseOwner             String
  fence                  BigInt
  leaseUntil             DateTime            @db.Timestamptz(3)
  failureCode            String?
  checkpoint             Json
  checkpointHash         String
  highEventSeq           BigInt
  eventCount             BigInt
  versionCount           BigInt
  lastAppendExpectedHash String?
  lastAppendStartSeq     BigInt?
  lastAppendEventCount   Int?
  lastAppendHash         String?
  processedThrough       DateTime            @db.Timestamp(3)
  generatorVersion       String
  runtimeVersion         String
  codec                  String
  publishedAt            DateTime?           @db.Timestamptz(3)
  certificateHash        String?
  mutationXid            Unsupported("xid8")
  runtime                MockSourceRuntime   @relation(fields: [organizationId, workspaceId, storeId, sessionId, connectionId, externalStoreId, generation], references: [organizationId, workspaceId, storeId, sessionId, connectionId, externalStoreId, generation], onDelete: Restrict, onUpdate: NoAction, map: "BuildJob_runtime_fkey")
  events                 MockSourceEvent[]

  @@id([sessionId, generation, revision], map: "BuildJob_pkey")
  @@unique([organizationId, workspaceId, storeId, sessionId, connectionId, externalStoreId, generation, revision], map: "BuildJob_scope_revision_key")
  @@unique([sessionId, generation, targetClockRevision], map: "BuildJob_target_key")
  @@map("BuildJob")
  @@schema("mock_platform")
}

model MockSourceEvent {
  organizationId  String
  workspaceId     String
  storeId         String
  sessionId       String
  connectionId    String
  externalStoreId String
  generation      Int
  releaseRevision BigInt
  eventSeq        BigInt
  eventId         String
  appendIndex     BigInt
  acceptedFence   BigInt
  occurredAt      DateTime                  @db.Timestamp(3)
  kind            String
  phaseRank       Int                       @db.SmallInt
  entityKey       String
  ordinal         BigInt
  payload         Json
  manifest        Json
  envelopeHash    String
  runtime         MockSourceRuntime         @relation(fields: [organizationId, workspaceId, storeId, sessionId, connectionId, externalStoreId, generation], references: [organizationId, workspaceId, storeId, sessionId, connectionId, externalStoreId, generation], onDelete: Restrict, onUpdate: NoAction, map: "SourceEvent_runtime_fkey")
  job             MockSourceBuildJob        @relation(fields: [organizationId, workspaceId, storeId, sessionId, connectionId, externalStoreId, generation, releaseRevision], references: [organizationId, workspaceId, storeId, sessionId, connectionId, externalStoreId, generation, revision], onDelete: Restrict, onUpdate: NoAction, map: "SourceEvent_job_fkey")
  versions        MockSourceEntityVersion[]

  @@id([sessionId, generation, eventSeq], map: "SourceEvent_pkey")
  @@unique([sessionId, generation, eventId], map: "SourceEvent_id_key")
  @@unique([organizationId, workspaceId, storeId, sessionId, connectionId, externalStoreId, generation, releaseRevision, eventSeq], map: "SourceEvent_scope_sequence_key")
  @@index([sessionId, generation, releaseRevision, appendIndex, eventSeq], map: "SourceEvent_job_append_idx")
  @@map("SourceEvent")
  @@schema("mock_platform")
}

model MockSourceEntityVersion {
  organizationId  String
  workspaceId     String
  storeId         String
  sessionId       String
  connectionId    String
  externalStoreId String
  generation      Int
  releaseRevision BigInt
  eventSeq        BigInt
  kind            String
  entityKey       String
  occurredAt      DateTime          @db.Timestamp(3)
  payload         Json
  versionHash     String
  runtime         MockSourceRuntime @relation(fields: [organizationId, workspaceId, storeId, sessionId, connectionId, externalStoreId, generation], references: [organizationId, workspaceId, storeId, sessionId, connectionId, externalStoreId, generation], onDelete: Restrict, onUpdate: NoAction, map: "EntityVersion_runtime_fkey")
  event           MockSourceEvent   @relation(fields: [organizationId, workspaceId, storeId, sessionId, connectionId, externalStoreId, generation, releaseRevision, eventSeq], references: [organizationId, workspaceId, storeId, sessionId, connectionId, externalStoreId, generation, releaseRevision, eventSeq], onDelete: Restrict, onUpdate: NoAction, map: "EntityVersion_event_fkey")

  @@id([sessionId, generation, eventSeq], map: "EntityVersion_pkey")
  @@index([sessionId, generation, kind, entityKey, eventSeq(sort: Desc)], map: "EntityVersion_entity_sequence_idx")
  @@index([sessionId, generation, kind, entityKey, occurredAt(sort: Desc), eventSeq(sort: Desc)], map: "EntityVersion_entity_time_idx")
  @@map("EntityVersion")
  @@schema("mock_platform")
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "demo", "mock_platform", "sync_host", "commerce"]
}

model CommerceSourceScope {
  id              String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String
  workspaceId     String
  storeId         String
  connectionId    String
  externalStoreId String
  provider        String
  generation      Int
  createdAt       DateTime                  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  connection      PlatformConnection        @relation(fields: [connectionId, organizationId, workspaceId, storeId, externalStoreId], references: [id, organizationId, workspaceId, storeId, externalStoreId], onDelete: Restrict, onUpdate: NoAction, map: "SourceScope_connection_fkey")
  products        CanonicalProductListing[]
  productCommits  SyncProductPageCommit[]

  @@unique([organizationId, workspaceId, storeId, connectionId, externalStoreId, provider, generation], map: "SourceScope_namespace_key")
  @@unique([id, organizationId, workspaceId, storeId], map: "SourceScope_tenant_key")
  @@map("SourceScope")
  @@schema("commerce")
}

model CanonicalProductListing {
  scopeId           String                @db.Uuid
  organizationId    String
  workspaceId       String
  storeId           String
  externalProductId String
  title             String
  description       String?
  category          String?
  brand             String?
  status            String
  sourceVersion     String?
  sourceUpdatedAt   DateTime?             @db.Timestamptz(3)
  sourcePayloadHash String
  qualityState      String
  qualityIssues     String[]
  ingestedAt        DateTime              @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  scope             CommerceSourceScope   @relation(fields: [scopeId, organizationId, workspaceId, storeId], references: [id, organizationId, workspaceId, storeId], onDelete: Restrict, onUpdate: NoAction, map: "ProductListing_scope_fkey")
  skus              CanonicalSkuListing[]

  @@id([scopeId, externalProductId])
  @@unique([scopeId, organizationId, workspaceId, storeId, externalProductId], map: "ProductListing_tenant_key")
  @@index([organizationId, workspaceId, storeId], map: "ProductListing_store_idx")
  @@map("ProductListing")
  @@schema("commerce")
}

model CanonicalSkuListing {
  scopeId            String                  @db.Uuid
  organizationId     String
  workspaceId        String
  storeId            String
  externalSkuId      String
  externalProductId  String
  attributes         Json
  salePriceMinor     BigInt
  costPriceMinor     BigInt?
  originalPriceMinor BigInt?
  status             String
  product            CanonicalProductListing @relation(fields: [scopeId, organizationId, workspaceId, storeId, externalProductId], references: [scopeId, organizationId, workspaceId, storeId, externalProductId], onDelete: Restrict, onUpdate: NoAction, map: "SkuListing_product_fkey")

  @@id([scopeId, externalSkuId])
  @@index([scopeId, externalProductId], map: "SkuListing_product_idx")
  @@map("SkuListing")
  @@schema("commerce")
}

model SyncWorkerGrant {
  id              String             @id
  databaseRole    String
  principalUserId String
  organizationId  String
  workspaceId     String
  storeId         String
  connectionId    String
  externalStoreId String
  provider        String
  generation      Int
  initialSince    DateTime           @db.Timestamp(3)
  status          String             @default("ACTIVE")
  jobs            SyncJob[]
  membership      OrganizationMember @relation(fields: [organizationId, principalUserId], references: [organizationId, userId], onDelete: Restrict, onUpdate: NoAction, map: "WorkerGrant_membership_fkey")
  assignment      WorkspaceMember    @relation(fields: [organizationId, workspaceId, principalUserId], references: [organizationId, workspaceId, userId], onDelete: Restrict, onUpdate: NoAction, map: "WorkerGrant_workspace_fkey")
  connection      PlatformConnection @relation(fields: [connectionId, organizationId, workspaceId, storeId, externalStoreId], references: [id, organizationId, workspaceId, storeId, externalStoreId], onDelete: Restrict, onUpdate: NoAction, map: "WorkerGrant_connection_fkey")

  @@map("WorkerGrant")
  @@schema("sync_host")
}

model SyncJob {
  id                String                  @id
  grantId           String
  organizationId    String
  workspaceId       String
  storeId           String
  connectionId      String
  externalStoreId   String
  provider          String
  generation        Int
  stream            String
  since             DateTime                @db.Timestamp(3)
  until             DateTime                @db.Timestamp(3)
  cursor            Json?
  successfulThrough DateTime?               @db.Timestamp(3)
  status            String                  @default("READY")
  fence             Int                     @default(0)
  leaseOwner        String?
  leaseUntil        DateTime?               @db.Timestamptz(3)
  leaseBackendPid   Int?
  leaseBackendStart DateTime?               @db.Timestamptz(6)
  failureCode       String?
  grant             SyncWorkerGrant         @relation(fields: [grantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "Job_grantId_fkey")
  receiptCursor     Json?
  receivedThrough   DateTime?               @db.Timestamp(3)
  pageReceipts      SyncPageReceipt[]
  productCommits    SyncProductPageCommit[]

  @@unique([id, organizationId, workspaceId, storeId], map: "Job_tenant_key")
  @@unique([organizationId, workspaceId, storeId, connectionId, externalStoreId, provider, generation, stream, since], map: "Job_scope_stream_window_key")
  @@map("Job")
  @@schema("sync_host")
}

model SyncPageReceipt {
  jobId           String
  pageId          String
  expectedCursor  String?
  nextCursor      String?
  receivedThrough DateTime               @db.Timestamp(3)
  pageHash        String
  createdAt       DateTime               @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  job             SyncJob                @relation(fields: [jobId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  productCommit   SyncProductPageCommit?

  @@id([jobId, pageId])
  @@map("PageReceipt")
  @@schema("sync_host")
}

model SyncProductPageCommit {
  jobId            String
  pageId           String
  scopeId          String                    @db.Uuid
  organizationId   String
  workspaceId      String
  storeId          String
  codec            String                    @default("product-page-v1")
  pageHash         String
  observedAt       DateTime                  @db.Timestamptz(3)
  sourceWatermark  DateTime?                 @db.Timestamptz(3)
  terminal         Boolean
  acceptedFence    Int
  inputCount       Int
  appliedCount     Int
  duplicateCount   Int
  staleCount       Int
  quarantinedCount Int
  skuInsertedCount Int
  skuDeletedCount  Int
  createdAt        DateTime                  @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(3)
  receipt          SyncPageReceipt           @relation(fields: [jobId, pageId], references: [jobId, pageId], onDelete: Restrict, onUpdate: NoAction, map: "ProductPageCommit_receipt_fkey")
  job              SyncJob                   @relation(fields: [jobId, organizationId, workspaceId, storeId], references: [id, organizationId, workspaceId, storeId], onDelete: Restrict, onUpdate: NoAction, map: "ProductPageCommit_job_fkey")
  scope            CommerceSourceScope       @relation(fields: [scopeId, organizationId, workspaceId, storeId], references: [id, organizationId, workspaceId, storeId], onDelete: Restrict, onUpdate: NoAction, map: "ProductPageCommit_scope_fkey")
  decisions        SyncProductPageDecision[]

  @@id([jobId, pageId])
  @@unique([jobId, pageId, organizationId, workspaceId, storeId], map: "ProductPageCommit_tenant_key")
  @@map("ProductPageCommit")
  @@schema("sync_host")
}

model SyncProductPageDecision {
  jobId               String
  pageId              String
  ordinal             Int
  organizationId      String
  workspaceId         String
  storeId             String
  externalProductId   String?
  candidateHash       String
  decision            String
  previousVersion     String?
  previousUpdatedAt   DateTime?              @db.Timestamptz(3)
  previousPayloadHash String?
  commit              SyncProductPageCommit  @relation(fields: [jobId, pageId, organizationId, workspaceId, storeId], references: [jobId, pageId, organizationId, workspaceId, storeId], onDelete: Restrict, onUpdate: NoAction, map: "ProductPageDecision_commit_fkey")
  quarantine          SyncProductQuarantine?

  @@id([jobId, pageId, ordinal])
  @@unique([jobId, pageId, ordinal, organizationId, workspaceId, storeId], map: "ProductPageDecision_tenant_key")
  @@map("ProductPageDecision")
  @@schema("sync_host")
}

model SyncProductQuarantine {
  jobId          String
  pageId         String
  ordinal        Int
  organizationId String
  workspaceId    String
  storeId        String
  reason         String
  decision       SyncProductPageDecision @relation(fields: [jobId, pageId, ordinal, organizationId, workspaceId, storeId], references: [jobId, pageId, ordinal, organizationId, workspaceId, storeId], onDelete: Restrict, onUpdate: NoAction, map: "ProductQuarantine_decision_fkey")

  @@id([jobId, pageId, ordinal])
  @@unique([jobId, pageId, ordinal, organizationId, workspaceId, storeId], map: "ProductQuarantine_tenant_key")
  @@map("ProductQuarantine")
  @@schema("sync_host")
}

model TenantBootstrapEnvironment {
  id          String @id
  environment String @default("UNCONFIGURED")

  @@schema("public")
}

enum MerchantStatus {
  ACTIVE
  INACTIVE

  @@schema("public")
}

enum ProductStatus {
  ACTIVE
  INACTIVE

  @@schema("public")
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED

  @@schema("public")
}

enum MonitoringRuleKind {
  SALES_THRESHOLD
  INVENTORY_THRESHOLD

  @@schema("public")
}

enum MonitoringRuleStatus {
  ACTIVE
  INACTIVE

  @@schema("public")
}

enum MonitoringFrequency {
  DAILY
  WEEKLY

  @@schema("public")
}

enum MonitoringSeverity {
  INFO
  WARNING
  CRITICAL

  @@schema("public")
}

enum MonitoringResourceType {
  MERCHANT
  SKU

  @@schema("public")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED

  @@schema("public")
}

enum MembershipStatus {
  ACTIVE
  INACTIVE

  @@schema("public")
}

enum TenantRole {
  OWNER
  ADMIN
  OPERATOR
  ANALYST
  VIEWER

  @@schema("public")
}

model Organization {
  id               String               @id @default(cuid())
  name             String
  status           OrganizationStatus   @default(ACTIVE)
  legacyMerchantId String?              @unique
  legacyMerchant   Merchant?            @relation(fields: [legacyMerchantId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "Organization_legacyMerchantId_fkey")
  demoTenant       DemoTenant?
  members          OrganizationMember[]
  workspaces       Workspace[]
  stores           Store[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@unique([legacyMerchantId, id])
  @@schema("public")
}

model OrganizationMember {
  id             String            @id @default(cuid())
  organizationId String
  userId         String
  role           TenantRole
  status         MembershipStatus  @default(ACTIVE)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workspaces     WorkspaceMember[]
  mockGrants     MockWorkerGrant[] @relation("WorkerMembership")
  syncGrants     SyncWorkerGrant[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@schema("public")
}

model Workspace {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  slug           String
  status         OrganizationStatus @default(ACTIVE)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  members        WorkspaceMember[]
  stores         Store[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, slug])
  @@schema("public")
}

model WorkspaceMember {
  id             String             @id @default(cuid())
  organizationId String
  workspaceId    String
  userId         String
  status         MembershipStatus   @default(ACTIVE)
  workspace      Workspace          @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade, onUpdate: NoAction, map: "WorkspaceMember_workspace_fkey")
  membership     OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade, onUpdate: NoAction, map: "WorkspaceMember_membership_fkey")
  mockGrants     MockWorkerGrant[]
  syncGrants     SyncWorkerGrant[]
  createdAt      DateTime           @default(now())

  @@unique([organizationId, workspaceId, userId])
  @@index([userId, status])
  @@schema("public")
}

model Merchant {
  id     String         @id @default(cuid())
  name   String
  slug   String         @unique
  status MerchantStatus @default(ACTIVE)

  products            Product[]
  skus                Sku[]
  orders              Order[]
  stores              Store[]
  dashboardLayouts    UserDashboardLayout[]
  analyticsLayouts    UserAnalyticsLayout[]
  assistantWorkspaces UserAssistantWorkspace[]
  assistantMemories   AssistantMemory[]
  monitoringRules     UserMonitoringRule[]
  notifications       MonitoringNotification[]
  userMemberships     UserMerchantMembership[]
  organization        Organization?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@schema("public")
}

model UserAccount {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String

  memberships UserMerchantMembership[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model UserMerchantMembership {
  userId     String
  merchantId String

  user     UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  merchant Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, merchantId])
  @@index([merchantId])
  @@schema("public")
}

model Product {
  id         String @id @default(cuid())
  merchantId String

  name          String
  description   String?
  features      Json?
  sellingPoints Json?

  price    Decimal @db.Decimal(12, 2)
  currency String  @default("CNY")

  status ProductStatus @default(ACTIVE)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  skus     Sku[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantId, id])
  @@index([merchantId])
  @@index([merchantId, status])
  @@schema("public")
}

model Sku {
  id         String @id @default(cuid())
  merchantId String
  productId  String

  code           String
  inventory      Int     @default(0)
  cost           Decimal @db.Decimal(12, 2)
  alertThreshold Int     @default(0)

  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [merchantId, productId], references: [merchantId, id], onDelete: Cascade, onUpdate: NoAction)
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantId, code])
  @@unique([merchantId, id])
  @@index([merchantId])
  @@index([productId])
  @@schema("public")
}

model Store {
  id             String               @id
  merchantId     String
  name           String
  city           String
  platform       String
  organizationId String               @default("")
  workspaceId    String               @default("")
  organization   Organization         @relation(fields: [merchantId, organizationId], references: [legacyMerchantId, id], onDelete: Restrict, onUpdate: NoAction)
  workspace      Workspace            @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict, onUpdate: NoAction)
  merchant       Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders         Order[]
  connections    PlatformConnection[]

  @@unique([merchantId, id])
  @@unique([organizationId, workspaceId, id])
  @@index([merchantId, platform])
  @@schema("public")
}

model Order {
  id         String  @id @default(cuid())
  merchantId String
  storeId    String?

  orderNo     String
  orderedAt   DateTime
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(12, 2)

  merchant Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  store    Store?      @relation(fields: [merchantId, storeId], references: [merchantId, id], onDelete: Restrict)
  items    OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantId, orderNo])
  @@unique([merchantId, id])
  @@index([merchantId, orderedAt])
  @@index([merchantId, storeId, orderedAt])
  @@index([status])
  @@schema("public")
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  skuId      String
  merchantId String @default("")

  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  lineAmount Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [merchantId, orderId], references: [merchantId, id], onDelete: Cascade, onUpdate: NoAction)
  sku   Sku   @relation(fields: [merchantId, skuId], references: [merchantId, id], onDelete: Restrict, onUpdate: NoAction)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([skuId])
  @@schema("public")
}

model UserDashboardLayout {
  id         String @id @default(cuid())
  userId     String
  merchantId String

  schemaVersion Int  @default(1)
  revision      Int  @default(1)
  layout        Json

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, merchantId])
  @@index([merchantId])
  @@schema("public")
}

// 经营分析页（首页）的卡片顺序、宽度与显隐；与旧版 UserDashboardLayout 分开存储，旧记录保留不动。
model UserAnalyticsLayout {
  id         String @id @default(cuid())
  userId     String
  merchantId String

  schemaVersion Int  @default(1)
  revision      Int  @default(1)
  layout        Json

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, merchantId])
  @@index([merchantId])
  @@schema("public")
}

// AI 助手对话记录，按用户 + 商家同步到服务端，换设备也能看到；revision 用于防止多设备互相覆盖。
model UserAssistantWorkspace {
  id         String @id @default(cuid())
  userId     String
  merchantId String

  revision Int  @default(1)
  snapshot Json

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, merchantId])
  @@index([merchantId])
  @@schema("public")
}

// AI 记住的用户偏好（单行短句），每次对话作为偏好上下文提供给模型，不作为经营数据依据。
model AssistantMemory {
  id         String @id @default(cuid())
  userId     String
  merchantId String
  content    String

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, merchantId, content])
  @@index([userId, merchantId, createdAt])
  @@index([merchantId])
  @@schema("public")
}

model UserMonitoringRule {
  id         String @id @default(cuid())
  userId     String
  merchantId String

  name       String
  kind       MonitoringRuleKind
  definition Json
  frequency  MonitoringFrequency
  status     MonitoringRuleStatus @default(ACTIVE)

  lastRunAt        DateTime?
  nextRunAt        DateTime
  lastErrorCode    String?
  lastErrorMessage String?

  merchant      Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  notifications MonitoringNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, merchantId, status, nextRunAt])
  @@index([merchantId])
  @@schema("public")
}

model MonitoringNotification {
  id         String @id @default(cuid())
  ruleId     String
  userId     String
  merchantId String

  fingerprint  String
  title        String
  message      String
  severity     MonitoringSeverity
  resourceType MonitoringResourceType
  resourceId   String
  periodStart  DateTime
  periodEnd    DateTime
  readAt       DateTime?

  rule     UserMonitoringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  merchant Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, merchantId, fingerprint])
  @@index([userId, merchantId, readAt, createdAt])
  @@index([ruleId])
  @@index([merchantId])
  @@schema("public")
}
