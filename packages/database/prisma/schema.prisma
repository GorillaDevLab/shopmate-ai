generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MerchantStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum MonitoringRuleKind {
  SALES_THRESHOLD
  INVENTORY_THRESHOLD
}

enum MonitoringRuleStatus {
  ACTIVE
  INACTIVE
}

enum MonitoringFrequency {
  DAILY
  WEEKLY
}

enum MonitoringSeverity {
  INFO
  WARNING
  CRITICAL
}

enum MonitoringResourceType {
  MERCHANT
  SKU
}

model Merchant {
  id     String         @id @default(cuid())
  name   String
  slug   String         @unique
  status MerchantStatus @default(ACTIVE)

  products         Product[]
  skus             Sku[]
  orders           Order[]
  stores           Store[]
  dashboardLayouts UserDashboardLayout[]
  monitoringRules  UserMonitoringRule[]
  notifications    MonitoringNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Product {
  id         String @id @default(cuid())
  merchantId String

  name          String
  description   String?
  features      Json?
  sellingPoints Json?

  price    Decimal @db.Decimal(12, 2)
  currency String  @default("CNY")

  status ProductStatus @default(ACTIVE)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  skus     Sku[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([merchantId])
  @@index([merchantId, status])
}

model Sku {
  id         String @id @default(cuid())
  merchantId String
  productId  String

  code           String
  inventory      Int     @default(0)
  cost           Decimal @db.Decimal(12, 2)
  alertThreshold Int     @default(0)

  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantId, code])
  @@index([merchantId])
  @@index([productId])
}

model Store {
  id         String   @id
  merchantId String
  name       String
  city       String
  platform   String
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([merchantId, id])
  @@index([merchantId, platform])
}

model Order {
  id         String  @id @default(cuid())
  merchantId String
  storeId    String?

  orderNo     String
  orderedAt   DateTime
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(12, 2)

  merchant Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  store    Store?      @relation(fields: [merchantId, storeId], references: [merchantId, id], onDelete: Restrict)
  items    OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantId, orderNo])
  @@index([merchantId, orderedAt])
  @@index([merchantId, storeId, orderedAt])
  @@index([status])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  skuId   String

  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  lineAmount Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku   Sku   @relation(fields: [skuId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([skuId])
}

model UserDashboardLayout {
  id         String @id @default(cuid())
  userId     String
  merchantId String

  schemaVersion Int  @default(1)
  revision      Int  @default(1)
  layout        Json

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, merchantId])
  @@index([merchantId])
}

model UserMonitoringRule {
  id         String @id @default(cuid())
  userId     String
  merchantId String

  name       String
  kind       MonitoringRuleKind
  definition Json
  frequency  MonitoringFrequency
  status     MonitoringRuleStatus @default(ACTIVE)

  lastRunAt        DateTime?
  nextRunAt        DateTime
  lastErrorCode    String?
  lastErrorMessage String?

  merchant      Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  notifications MonitoringNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, merchantId, status, nextRunAt])
  @@index([merchantId])
}

model MonitoringNotification {
  id         String @id @default(cuid())
  ruleId     String
  userId     String
  merchantId String

  fingerprint  String
  title        String
  message      String
  severity     MonitoringSeverity
  resourceType MonitoringResourceType
  resourceId   String
  periodStart  DateTime
  periodEnd    DateTime
  readAt       DateTime?

  rule     UserMonitoringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  merchant Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, merchantId, fingerprint])
  @@index([userId, merchantId, readAt, createdAt])
  @@index([ruleId])
  @@index([merchantId])
}
