generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model TenantBootstrapEnvironment {
  id          String @id
  environment String @default("UNCONFIGURED")
}

enum MerchantStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
}

enum MonitoringRuleKind {
  SALES_THRESHOLD
  INVENTORY_THRESHOLD
}

enum MonitoringRuleStatus {
  ACTIVE
  INACTIVE
}

enum MonitoringFrequency {
  DAILY
  WEEKLY
}

enum MonitoringSeverity {
  INFO
  WARNING
  CRITICAL
}

enum MonitoringResourceType {
  MERCHANT
  SKU
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
}

enum TenantRole {
  OWNER
  ADMIN
  OPERATOR
  ANALYST
  VIEWER
}

model Organization {
  id               String               @id @default(cuid())
  name             String
  status           OrganizationStatus   @default(ACTIVE)
  legacyMerchantId String?              @unique
  legacyMerchant   Merchant?            @relation(fields: [legacyMerchantId], references: [id], onDelete: Restrict)
  members          OrganizationMember[]
  workspaces       Workspace[]
  stores           Store[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model OrganizationMember {
  id             String            @id @default(cuid())
  organizationId String
  userId         String
  role           TenantRole
  status         MembershipStatus  @default(ACTIVE)
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspaces     WorkspaceMember[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model Workspace {
  id             String             @id @default(cuid())
  organizationId String
  name           String
  slug           String
  status         OrganizationStatus @default(ACTIVE)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        WorkspaceMember[]
  stores         Store[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([organizationId, id])
  @@unique([organizationId, slug])
}

model WorkspaceMember {
  id             String             @id @default(cuid())
  organizationId String
  workspaceId    String
  userId         String
  status         MembershipStatus   @default(ACTIVE)
  workspace      Workspace          @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Cascade)
  membership     OrganizationMember @relation(fields: [organizationId, userId], references: [organizationId, userId], onDelete: Cascade)
  createdAt      DateTime           @default(now())

  @@unique([organizationId, workspaceId, userId])
  @@index([userId, status])
}

model Merchant {
  id     String         @id @default(cuid())
  name   String
  slug   String         @unique
  status MerchantStatus @default(ACTIVE)

  products         Product[]
  skus             Sku[]
  orders           Order[]
  stores           Store[]
  dashboardLayouts UserDashboardLayout[]
  monitoringRules  UserMonitoringRule[]
  notifications    MonitoringNotification[]
  organization     Organization?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Product {
  id         String @id @default(cuid())
  merchantId String

  name          String
  description   String?
  features      Json?
  sellingPoints Json?

  price    Decimal @db.Decimal(12, 2)
  currency String  @default("CNY")

  status ProductStatus @default(ACTIVE)

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  skus     Sku[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantId, id])
  @@index([merchantId])
  @@index([merchantId, status])
}

model Sku {
  id         String @id @default(cuid())
  merchantId String
  productId  String

  code           String
  inventory      Int     @default(0)
  cost           Decimal @db.Decimal(12, 2)
  alertThreshold Int     @default(0)

  merchant   Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [merchantId, productId], references: [merchantId, id], onDelete: Cascade)
  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantId, code])
  @@unique([merchantId, id])
  @@index([merchantId])
  @@index([productId])
}

model Store {
  id             String       @id
  merchantId     String
  name           String
  city           String
  platform       String
  organizationId String       @default(dbgenerated("NULL::text"))
  workspaceId    String       @default(dbgenerated("NULL::text"))
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workspace      Workspace    @relation(fields: [organizationId, workspaceId], references: [organizationId, id], onDelete: Restrict)
  merchant       Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orders         Order[]

  @@unique([merchantId, id])
  @@index([merchantId, platform])
}

model Order {
  id         String  @id @default(cuid())
  merchantId String
  storeId    String?

  orderNo     String
  orderedAt   DateTime
  status      OrderStatus @default(PENDING)
  totalAmount Decimal     @db.Decimal(12, 2)

  merchant Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  store    Store?      @relation(fields: [merchantId, storeId], references: [merchantId, id], onDelete: Restrict)
  items    OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([merchantId, orderNo])
  @@unique([merchantId, id])
  @@index([merchantId, orderedAt])
  @@index([merchantId, storeId, orderedAt])
  @@index([status])
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  skuId      String
  merchantId String @default(dbgenerated("NULL::text"))

  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  lineAmount Decimal @db.Decimal(12, 2)

  order Order @relation(fields: [merchantId, orderId], references: [merchantId, id], onDelete: Cascade)
  sku   Sku   @relation(fields: [merchantId, skuId], references: [merchantId, id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([skuId])
}

model UserDashboardLayout {
  id         String @id @default(cuid())
  userId     String
  merchantId String

  schemaVersion Int  @default(1)
  revision      Int  @default(1)
  layout        Json

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, merchantId])
  @@index([merchantId])
}

model UserMonitoringRule {
  id         String @id @default(cuid())
  userId     String
  merchantId String

  name       String
  kind       MonitoringRuleKind
  definition Json
  frequency  MonitoringFrequency
  status     MonitoringRuleStatus @default(ACTIVE)

  lastRunAt        DateTime?
  nextRunAt        DateTime
  lastErrorCode    String?
  lastErrorMessage String?

  merchant      Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  notifications MonitoringNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, merchantId, status, nextRunAt])
  @@index([merchantId])
}

model MonitoringNotification {
  id         String @id @default(cuid())
  ruleId     String
  userId     String
  merchantId String

  fingerprint  String
  title        String
  message      String
  severity     MonitoringSeverity
  resourceType MonitoringResourceType
  resourceId   String
  periodStart  DateTime
  periodEnd    DateTime
  readAt       DateTime?

  rule     UserMonitoringRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  merchant Merchant           @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, merchantId, fingerprint])
  @@index([userId, merchantId, readAt, createdAt])
  @@index([ruleId])
  @@index([merchantId])
}
